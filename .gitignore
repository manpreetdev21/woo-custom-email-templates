# Dependencies
/vendor/
/node_modules/
composer.lock
package-lock.json
yarn.lock

# Build output
/build/
/dist/
/release/
*.zip

# Compiled translations — .po/.pot stay in the repo, .mo is generated
languages/*.mo

# Editors and IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*.swo
*~

# OS noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Logs and local scratch
*.log
/logs/
*.bak
*.orig
*.rej
.phpunit.result.cache
.php-cs-fixer.cache
.phpcs-cache

# Local overrides of committed tooling config
phpcs.xml
phpunit.xml
!phpcs.xml.dist
!phpunit.xml.dist

# Local environment — never commit credentials or machine-specific config
.env
.env.*
!.env.example
wp-cli.local.yml
